        "print(nulos.head(20))\n",
        "\n",
        "# 5. Filtrado de columnas útiles (menos de 30% nulos)\n",
        "columnas_utiles = nulos[nulos < 0.3].index.tolist()\n",
        "df_util = df[columnas_utiles]\n",
        "\n",
        "# 6. Mostrar tipos de variables (numéricas vs categóricas)\n",
        "tipos = df_util.dtypes.value_counts()\n",
